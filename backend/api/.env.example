# backend/api environment (docs/02-mimari.md). Copy to .env; never commit .env.
NODE_ENV=development

# HTTP API (:4000) and OCPP Central System (:9000)
PORT=4000
OCPP_PORT=9000

# MongoDB Atlas. Keep the real URI in this untracked .env only; it is never logged.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/
MONGODB_DB_NAME=chargemesh
# Yalnızca opt-in smoke testi için ayrı ve kısıtlı Atlas kullanıcısı.
MONGODB_TEST_URI=

# Exact base URL of the web app; used for the QR start URL and CORS origin.
# Production requires https://.
WEB_BASE_URL=http://localhost:3000

# Runtime uses the real Monad testnet. mock is accepted only by automated tests.
CHAIN_MODE=monad
RPC_URL=https://testnet-rpc.monad.xyz

# testnet only - never put a mainnet or funded personal key here.
# Signs quotes (EIP-712) and sends startSession/settle.
SETTLER_PRIVATE_KEY=

QUOTE_TTL_SECONDS=300
RECONCILIATION_INTERVAL_MS=30000
DEMO_ALLOW_ANY_TIME=false
