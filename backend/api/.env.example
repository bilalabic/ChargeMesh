# backend/api environment (docs/02-mimari.md). Copy to .env; never commit .env.
NODE_ENV=development

# HTTP API (:4000) and OCPP Central System (:9000)
PORT=4000
OCPP_PORT=9000

# PostgreSQL (docker compose, see root `corepack pnpm db:up`)
DATABASE_URL=postgres://chargemesh:chargemesh@localhost:5433/chargemesh

# Base URL of the web app; used for the QR start URL and CORS origin
WEB_BASE_URL=http://localhost:3000

# mock | anvil | monad
CHAIN_MODE=mock
RPC_URL=https://testnet-rpc.monad.xyz

# testnet only - never put a mainnet or funded personal key here.
# Signs quotes (EIP-712) and sends startSession/settle. In CHAIN_MODE=mock an
# ephemeral key is generated when this is empty.
SETTLER_PRIVATE_KEY=

QUOTE_TTL_SECONDS=300
DEMO_ALLOW_ANY_TIME=true
