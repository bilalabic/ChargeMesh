{
  "name": "@chargemesh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:indexes": "tsx --env-file-if-exists=.env src/db/indexes-cli.ts"
  },
  "dependencies": {
    "@chargemesh/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5",
    "mongodb": "^7.6.0",
    "ocpp-rpc": "^2.2.1",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
