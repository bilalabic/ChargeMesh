# backend/charger-sim environment (docs/05-ocpp.md). CLI flags override these.
# Central System base URL; the charge point id is appended: ${CS_URL}/${CHARGE_POINT_ID}
CS_URL=ws://localhost:9000/ocpp
CHARGE_POINT_ID=CM-DEMO-001
CONNECTOR_ID=1
# Constant charging power (kW)
POWER_KW=7.4
# Simulation speed: 120 means 1 real second = 2 simulated minutes
TIME_SCALE=120
# Real-time sampling interval (ms)
METER_INTERVAL_MS=2000
# Meter register start value (Wh)
METER_START_WH=1000000
# Optional: the vehicle leaves (reason EVDisconnected) after accepting this many Wh. Empty = unlimited.
VEHICLE_ACCEPT_WH=
