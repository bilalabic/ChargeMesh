# REST API base URL (backend/api). Used only when NEXT_PUBLIC_API_MODE=live.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# mock: in-browser fixtures, no API or chain needed. live: talks to backend/api.
NEXT_PUBLIC_API_MODE=mock
# 10143 (Monad testnet) or 31337 (local Anvil)
NEXT_PUBLIC_CHAIN_ID=10143
