# ChargeMesh contracts — copy to .env (never commit .env).
# Testnet / local only. Never put a mainnet key here.

# RPC endpoint: http://localhost:8545 (anvil) or https://testnet-rpc.monad.xyz (Monad testnet)
RPC_URL=http://localhost:8545

# Deployer private key (0x-prefixed hex). TESTNET ONLY — never a mainnet or funded personal key.
DEPLOYER_PRIVATE_KEY=

# Backend settler EOA address (signs quotes, calls startSession/settle).
# Optional: leave empty to use the deployer address as settler (hackathon default).
SETTLER_ADDRESS=
